[Unit]
Description=FRLG Trade Console dashboard (docker compose)
# Docker must be up before compose can do anything, and the network target
# avoids racing NetworkManager for the interface the container inspects.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/docker compose up -d dashboard
ExecStop=/usr/bin/docker compose stop dashboard
# compose pulls/builds can be slow on a cold boot.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
