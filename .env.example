# Machine-specific settings. Copy to .env and edit.
# Nothing in here is a secret; prod.keys is never referenced by path here.

# The wireless interface LDN will take over, and the phy it belongs to.
FRLG_WIFI_IF=wlan0
FRLG_PHY=phy0

# A second interface that keeps this machine online while the radio is busy.
# Without one, freeing the radio would cut your own access, and the scripts
# refuse to proceed rather than strand you.
FRLG_WIRED_IF=eth0
FRLG_WIRED_CON=frlg-wired

# The NetworkManager connection to restore on the wireless interface afterwards.
FRLG_WIFI_CON=

# Your console's LDN local_communication_id. Upstream hardcodes
# 0x0100610011000000, but the GBA NSO app advertises a different id per
# region/version -- run "Scan for console" and use the value it prints.
FRLG_COMM_ID=

# Scan tuning. The library defaults to a 0.11s dwell over 2.4GHz only, which
# misses a console easily.
FRLG_CHANNELS=1,6,11,36,40,44,48
FRLG_SCAN_DWELL=0.60
FRLG_JOIN_ATTEMPTS=8
