# --- never commit: console keys and anything derived from your own hardware ---
keys/*
!keys/README.md
!keys/.gitkeep
*.keys
!.env.example

# --- never publish: local AI-assistant notes ---
CLAUDE.md
.claude/

# --- machine-specific config ---
.env

# --- fetched by scripts/setup.sh, deliberately not redistributed here -------
# Upstream's engine is AGPL-3.0 and belongs to its authors; we ship patches
# against it instead of a copy of it.
vendor/
# Sprites are Nintendo's artwork. Fetched locally at setup; not ours to publish.
web/static/sprites/
# Game data derived from the PokeAPI dataset; regenerated by setup.
data/*.json

# --- runtime state ----------------------------------------------------------
out/
box/
control/
pk3/*.pk3
pk3/*.ek3
pk3/party.json

# --- python / editors -------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
*.swp
